generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users & Institutes
// ---------------------------------------------------------------------------

model Institute {
  id             Int      @id @default(autoincrement())
  /// Public login code (users enter it when the same phone exists in several institutes)
  code           String   @unique
  name           String
  logoUrl        String   @map("logo_url")
  primaryColor   String   @map("primary_color")
  secondaryColor String   @map("secondary_color")
  phone          String
  address        String
  /// IANA time zone used for "today", due dates and attendance (role.md §5.10)
  timezone       String   @default("Asia/Damascus")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  users                 User[]
  branches              Branch[]
  instituteAdmins       InstituteAdmin[]
  academicYears         AcademicYear[]
  academicBranches      AcademicBranch[]
  teachers              Teacher[]
  branchTeachers        BranchTeacher[]
  teacherAssignments    TeacherAssignment[]
  teacherAvailabilities TeacherAvailability[]
  rooms                 Room[]
  roomAvailabilities    RoomAvailability[]
  scheduleConfig        InstituteScheduleConfig?
  families              Family[]
  familyUsers           FamilyUser[]
  students              Student[]
  studentFields         StudentField[]
  sections              Section[]
  studentEnrollments    StudentEnrollment[]
  subjects              Subject[]
  sectionSubjects       SectionSubject[]
  sectionTeachers       SectionTeacher[]
  timetables            Timetable[]
  timetableEntries      TimetableEntry[]
  lessons               Lesson[]
  exams                 Exam[]
  examResults           ExamResult[]
  lessonAttendance      LessonAttendance[]
  studentSubscriptions  StudentSubscription[]
  installments          Installment[]
  payments              Payment[]
  examTypes             ExamType[]
  enrollmentSubjects    EnrollmentSubject[]
  receiptSequences      ReceiptSequence[]
  auditLogs             AuditLog[]
  features              InstituteFeature[]

  @@map("institutes")
}

model User {
  id           Int       @id @default(autoincrement())
  instituteId  Int       @map("institute_id")
  fullName     String    @map("full_name")
  phone        String
  passwordHash String    @map("password_hash")
  role         String
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  institute      Institute       @relation(fields: [instituteId], references: [id])
  instituteAdmin InstituteAdmin?
  teacher        Teacher?
  familyUsers    FamilyUser[]
  refreshTokens  RefreshToken[]
  student        Student?

  /// Phone is unique per institute (same parent may belong to several institutes)
  @@unique([instituteId, phone])
  @@index([phone])
  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Branches
// ---------------------------------------------------------------------------

model Branch {
  id          Int      @id @default(autoincrement())
  instituteId Int      @map("institute_id")
  name        String
  phone       String
  address     String
  isActive    Boolean  @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute        Institute         @relation(fields: [instituteId], references: [id])
  branchTeachers   BranchTeacher[]
  sections         Section[]
  rooms            Room[]
  students         Student[]
  payments         Payment[]
  receiptSequences ReceiptSequence[]

  @@unique([instituteId, name])
  @@unique([instituteId, id])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Institute Administration
// ---------------------------------------------------------------------------

model InstituteAdmin {
  id          Int      @id @default(autoincrement())
  instituteId Int      @map("institute_id")
  userId      Int      @unique @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([instituteId, userId])
  @@map("institute_admins")
}

// ---------------------------------------------------------------------------
// Academic
// ---------------------------------------------------------------------------

model AcademicYear {
  id          Int      @id @default(autoincrement())
  instituteId Int      @map("institute_id")
  name        String
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  isCurrent   Boolean  @map("is_current")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute            Institute             @relation(fields: [instituteId], references: [id])
  sections             Section[]
  studentEnrollments   StudentEnrollment[]
  timetables           Timetable[]
  studentSubscriptions StudentSubscription[]
  payments             Payment[]
  receiptSequences     ReceiptSequence[]

  @@unique([instituteId, id])
  @@unique([instituteId, name])
  @@map("academic_years")
}

model AcademicBranch {
  id          Int      @id @default(autoincrement())
  instituteId Int      @map("institute_id")
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute          Institute           @relation(fields: [instituteId], references: [id])
  sections           Section[]
  teacherAssignments TeacherAssignment[]

  @@unique([instituteId, id])
  @@unique([instituteId, name])
  @@map("academic_branches")
}

model Teacher {
  id             Int       @id @default(autoincrement())
  instituteId    Int       @map("institute_id")
  userId         Int       @unique @map("user_id")
  specialization String?
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  createdById    Int?      @map("created_by_id")
  updatedById    Int?      @map("updated_by_id")

  institute        Institute             @relation(fields: [instituteId], references: [id])
  user             User                  @relation(fields: [userId], references: [id])
  branchTeachers   BranchTeacher[]
  sectionTeachers  SectionTeacher[]
  assignments      TeacherAssignment[]
  availabilities   TeacherAvailability[]
  sectionSubjects  SectionSubject[]
  timetableEntries TimetableEntry[]
  lessons          Lesson[]

  @@unique([instituteId, id])
  @@unique([instituteId, userId])
  @@map("teachers")
}

model TeacherAssignment {
  id               Int      @id @default(autoincrement())
  instituteId      Int      @map("institute_id")
  teacherId        Int      @map("teacher_id")
  academicBranchId Int      @map("academic_branch_id")
  subjectId        Int      @map("subject_id")
  createdAt        DateTime @default(now()) @map("created_at")

  institute      Institute      @relation(fields: [instituteId], references: [id])
  teacher        Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicBranch AcademicBranch @relation(fields: [academicBranchId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([instituteId, id])
  @@unique([instituteId, teacherId, academicBranchId, subjectId])
  @@map("teacher_assignments")
}

model TeacherAvailability {
  id          Int      @id @default(autoincrement())
  instituteId Int      @map("institute_id")
  teacherId   Int      @map("teacher_id")
  dayOfWeek   Int      @map("day_of_week")
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([instituteId, id])
  @@index([instituteId, teacherId])
  @@map("teacher_availabilities")
}

model BranchTeacher {
  id          Int      @id @default(autoincrement())
  instituteId Int      @map("institute_id")
  branchId    Int      @map("branch_id")
  teacherId   Int      @map("teacher_id")
  createdAt   DateTime @default(now()) @map("created_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  branch    Branch    @relation(fields: [branchId], references: [id])
  teacher   Teacher   @relation(fields: [teacherId], references: [id])

  @@unique([instituteId, branchId, teacherId])
  @@map("branch_teachers")
}

model Family {
  id          Int       @id @default(autoincrement())
  instituteId Int       @map("institute_id")
  familyName  String    @map("family_name")
  fatherName  String?   @map("father_name")
  motherName  String?   @map("mother_name")
  phone       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById Int?      @map("created_by_id")
  updatedById Int?      @map("updated_by_id")

  institute   Institute    @relation(fields: [instituteId], references: [id])
  familyUsers FamilyUser[]
  students    Student[]

  @@unique([instituteId, id])
  @@map("families")
}

model FamilyUser {
  id           Int                  @id @default(autoincrement())
  instituteId  Int                  @map("institute_id")
  familyId     Int                  @map("family_id")
  userId       Int                  @map("user_id")
  relationship GuardianRelationship
  createdAt    DateTime             @default(now()) @map("created_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  family    Family    @relation(fields: [familyId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([instituteId, familyId, userId])
  @@map("family_users")
}

model Student {
  id           Int       @id @default(autoincrement())
  instituteId  Int       @map("institute_id")
  branchId     Int       @map("branch_id")
  familyId     Int       @map("family_id")
  userId       Int?      @unique @map("user_id")
  fullName     String    @map("full_name")
  birthDate    DateTime  @map("birth_date") @db.Date
  gender       Gender
  customFields Json?     @default("{}") @map("custom_fields")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdById  Int?      @map("created_by_id")
  updatedById  Int?      @map("updated_by_id")

  institute            Institute             @relation(fields: [instituteId], references: [id])
  branch               Branch                @relation(fields: [branchId], references: [id])
  family               Family                @relation(fields: [familyId], references: [id])
  user                 User?                 @relation(fields: [userId], references: [id])
  studentEnrollments   StudentEnrollment[]
  examResults          ExamResult[]
  lessonAttendance     LessonAttendance[]
  studentSubscriptions StudentSubscription[]

  @@unique([instituteId, id])
  @@map("students")
}

model StudentField {
  id              Int      @id @default(autoincrement())
  instituteId     Int      @map("institute_id")
  name            String
  label           String
  type            String
  options         Json?    @default("[]")
  isRequired      Boolean  @default(false) @map("is_required")
  displayInReport Boolean  @default(false) @map("display_in_report")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id])

  @@unique([instituteId, id])
  @@unique([instituteId, name])
  @@map("student_fields")
}

// ---------------------------------------------------------------------------
// Sections
// ---------------------------------------------------------------------------

model Section {
  id               Int       @id @default(autoincrement())
  instituteId      Int       @map("institute_id")
  branchId         Int       @map("branch_id")
  academicYearId   Int       @map("academic_year_id")
  academicBranchId Int       @map("academic_branch_id")
  name             String
  grade            String?
  feeAmount        Decimal   @map("fee_amount") @db.Decimal(18, 2)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  createdById      Int?      @map("created_by_id")
  updatedById      Int?      @map("updated_by_id")

  institute            Institute             @relation(fields: [instituteId], references: [id])
  branch               Branch                @relation(fields: [branchId], references: [id])
  academicYear         AcademicYear          @relation(fields: [academicYearId], references: [id])
  academicBranch       AcademicBranch        @relation(fields: [academicBranchId], references: [id])
  studentEnrollments   StudentEnrollment[]
  sectionSubjects      SectionSubject[]
  sectionTeachers      SectionTeacher[]
  timetables           Timetable[]
  lessons              Lesson[]
  studentSubscriptions StudentSubscription[]
  exams                Exam[]

  @@unique([instituteId, id])
  @@unique([instituteId, branchId, academicYearId, name])
  @@map("sections")
}

model StudentEnrollment {
  id             Int              @id @default(autoincrement())
  instituteId    Int              @map("institute_id")
  studentId      Int              @map("student_id")
  academicYearId Int              @map("academic_year_id")
  sectionId      Int              @map("section_id")
  enrolledAt     DateTime         @map("enrolled_at")
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  createdById    Int?             @map("created_by_id")
  updatedById    Int?             @map("updated_by_id")

  institute    Institute           @relation(fields: [instituteId], references: [id])
  student      Student             @relation(fields: [studentId], references: [id])
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id])
  section      Section             @relation(fields: [sectionId], references: [id])
  subjects     EnrollmentSubject[]

  @@unique([instituteId, id])
  @@unique([instituteId, studentId, academicYearId])
  @@map("student_enrollments")
}

/// Subjects a student takes inside the enrolled section.
/// No rows for an enrollment means the student takes ALL section subjects.
model EnrollmentSubject {
  id           Int                     @id @default(autoincrement())
  instituteId  Int                     @map("institute_id")
  enrollmentId Int                     @map("enrollment_id")
  subjectId    Int                     @map("subject_id")
  status       EnrollmentSubjectStatus @default(ACTIVE)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  createdById  Int?                    @map("created_by_id")
  updatedById  Int?                    @map("updated_by_id")

  institute  Institute         @relation(fields: [instituteId], references: [id])
  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  subject    Subject           @relation(fields: [subjectId], references: [id])

  @@unique([instituteId, id])
  @@unique([instituteId, enrollmentId, subjectId])
  @@map("enrollment_subjects")
}

// ---------------------------------------------------------------------------
// Subjects
// ---------------------------------------------------------------------------

model Subject {
  id          Int       @id @default(autoincrement())
  instituteId Int       @map("institute_id")
  name        String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById Int?      @map("created_by_id")
  updatedById Int?      @map("updated_by_id")

  institute          Institute           @relation(fields: [instituteId], references: [id])
  sectionSubjects    SectionSubject[]
  sectionTeachers    SectionTeacher[]
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  lessons            Lesson[]
  exams              Exam[]
  enrollmentSubjects EnrollmentSubject[]

  @@unique([instituteId, id])
  @@unique([instituteId, name])
  @@map("subjects")
}

model SectionSubject {
  id            Int      @id @default(autoincrement())
  instituteId   Int      @map("institute_id")
  sectionId     Int      @map("section_id")
  subjectId     Int      @map("subject_id")
  teacherId     Int?     @map("teacher_id")
  weeklyPeriods Int      @default(1) @map("weekly_periods")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  section   Section   @relation(fields: [sectionId], references: [id])
  subject   Subject   @relation(fields: [subjectId], references: [id])
  teacher   Teacher?  @relation(fields: [teacherId], references: [id])

  @@unique([instituteId, sectionId, subjectId])
  @@map("section_subjects")
}

model SectionTeacher {
  id          Int      @id @default(autoincrement())
  instituteId Int      @map("institute_id")
  sectionId   Int      @map("section_id")
  teacherId   Int      @map("teacher_id")
  subjectId   Int      @map("subject_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  section   Section   @relation(fields: [sectionId], references: [id])
  teacher   Teacher   @relation(fields: [teacherId], references: [id])
  subject   Subject   @relation(fields: [subjectId], references: [id])

  @@unique([instituteId, sectionId, teacherId, subjectId])
  @@map("section_teachers")
}

// ---------------------------------------------------------------------------
// Rooms
// ---------------------------------------------------------------------------

model Room {
  id          Int       @id @default(autoincrement())
  instituteId Int       @map("institute_id")
  branchId    Int       @map("branch_id")
  name        String
  capacity    Int       @default(30)
  type        String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById Int?      @map("created_by_id")
  updatedById Int?      @map("updated_by_id")

  institute        Institute          @relation(fields: [instituteId], references: [id])
  branch           Branch             @relation(fields: [branchId], references: [id])
  availabilities   RoomAvailability[]
  timetableEntries TimetableEntry[]

  @@unique([instituteId, id])
  @@unique([instituteId, branchId, name])
  @@map("rooms")
}

model RoomAvailability {
  id          Int      @id @default(autoincrement())
  instituteId Int      @map("institute_id")
  roomId      Int      @map("room_id")
  dayOfWeek   Int      @map("day_of_week")
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([instituteId, id])
  @@index([instituteId, roomId])
  @@map("room_availabilities")
}

// ---------------------------------------------------------------------------
// Schedule Configuration
// ---------------------------------------------------------------------------

model InstituteScheduleConfig {
  id                    Int      @id @default(autoincrement())
  instituteId           Int      @unique @map("institute_id")
  workingDays           Int[]    @map("working_days")
  dayStartTime          String   @map("day_start_time")
  dayEndTime            String   @map("day_end_time")
  periodDurationMinutes Int      @map("period_duration_minutes")
  breaks                Json     @default("[]")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id])

  @@unique([instituteId, id])
  @@map("institute_schedule_configs")
}

// ---------------------------------------------------------------------------
// Timetables
// ---------------------------------------------------------------------------

model Timetable {
  id             Int      @id @default(autoincrement())
  instituteId    Int      @map("institute_id")
  academicYearId Int      @map("academic_year_id")
  sectionId      Int      @map("section_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  institute    Institute        @relation(fields: [instituteId], references: [id])
  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id])
  section      Section          @relation(fields: [sectionId], references: [id])
  entries      TimetableEntry[]

  @@unique([instituteId, id])
  @@unique([instituteId, academicYearId, sectionId])
  @@map("timetables")
}

model TimetableEntry {
  id           Int      @id @default(autoincrement())
  instituteId  Int      @map("institute_id")
  timetableId  Int      @map("timetable_id")
  subjectId    Int      @map("subject_id")
  teacherId    Int      @map("teacher_id")
  roomId       Int?     @map("room_id")
  dayOfWeek    Int      @map("day_of_week")
  periodNumber Int?     @map("period_number")
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  isLocked     Boolean  @default(false) @map("is_locked")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  timetable Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id])
  teacher   Teacher   @relation(fields: [teacherId], references: [id])
  room      Room?     @relation(fields: [roomId], references: [id])
  lessons   Lesson[]

  @@unique([instituteId, id])
  @@index([instituteId, timetableId])
  @@index([instituteId, teacherId, dayOfWeek])
  @@index([instituteId, roomId, dayOfWeek])
  @@map("timetable_entries")
}

// ---------------------------------------------------------------------------
// Lessons
// ---------------------------------------------------------------------------

model Lesson {
  id               Int        @id @default(autoincrement())
  instituteId      Int        @map("institute_id")
  sectionId        Int        @map("section_id")
  timetableEntryId Int?       @map("timetable_entry_id")
  subjectId        Int        @map("subject_id")
  teacherId        Int?       @map("teacher_id")
  lessonType       LessonType @default(REGULAR) @map("lesson_type")
  startsAt         DateTime   @map("starts_at")
  endsAt           DateTime   @map("ends_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  institute      Institute          @relation(fields: [instituteId], references: [id])
  section        Section            @relation(fields: [sectionId], references: [id])
  timetableEntry TimetableEntry?    @relation(fields: [timetableEntryId], references: [id])
  subject        Subject            @relation(fields: [subjectId], references: [id])
  teacher        Teacher?           @relation(fields: [teacherId], references: [id])
  exam           Exam?
  attendance     LessonAttendance[]

  @@unique([instituteId, id])
  @@index([instituteId, sectionId, startsAt])
  @@map("lessons")
}

// ---------------------------------------------------------------------------
// Exams
// ---------------------------------------------------------------------------

model ExamType {
  id          Int      @id @default(autoincrement())
  instituteId Int      @map("institute_id")
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id])
  exams     Exam[]

  @@unique([instituteId, id])
  @@unique([instituteId, name])
  @@map("exam_types")
}

/// An exam is defined by section + subject (+ optional type). Linking it to a
/// concrete lesson is optional.
model Exam {
  id          Int      @id @default(autoincrement())
  instituteId Int      @map("institute_id")
  sectionId   Int      @map("section_id")
  subjectId   Int      @map("subject_id")
  examTypeId  Int?     @map("exam_type_id")
  lessonId    Int?     @unique @map("lesson_id")
  title       String
  examDate    DateTime @map("exam_date") @db.Date
  maxMark     Decimal  @map("max_mark") @db.Decimal(10, 2)
  passMark    Decimal  @map("pass_mark") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById Int?     @map("created_by_id")
  updatedById Int?     @map("updated_by_id")

  institute Institute    @relation(fields: [instituteId], references: [id])
  section   Section      @relation(fields: [sectionId], references: [id])
  subject   Subject      @relation(fields: [subjectId], references: [id])
  examType  ExamType?    @relation(fields: [examTypeId], references: [id])
  lesson    Lesson?      @relation(fields: [lessonId], references: [id])
  results   ExamResult[]

  @@unique([instituteId, id])
  @@index([instituteId, sectionId, subjectId])
  @@map("exams")
}

model ExamResult {
  id          Int              @id @default(autoincrement())
  instituteId Int              @map("institute_id")
  examId      Int              @map("exam_id")
  studentId   Int              @map("student_id")
  mark        Decimal?         @db.Decimal(10, 2)
  status      ExamResultStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  createdById Int?             @map("created_by_id")
  updatedById Int?             @map("updated_by_id")

  institute Institute @relation(fields: [instituteId], references: [id])
  exam      Exam      @relation(fields: [examId], references: [id])
  student   Student   @relation(fields: [studentId], references: [id])

  @@unique([instituteId, id])
  @@unique([instituteId, examId, studentId])
  @@map("exam_results")
}

// ---------------------------------------------------------------------------
// Attendance (per lesson)
// ---------------------------------------------------------------------------

model LessonAttendance {
  id          Int              @id @default(autoincrement())
  instituteId Int              @map("institute_id")
  lessonId    Int              @map("lesson_id")
  studentId   Int              @map("student_id")
  status      AttendanceStatus
  markedAt    DateTime         @map("marked_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  createdById Int?             @map("created_by_id")
  updatedById Int?             @map("updated_by_id")

  institute Institute @relation(fields: [instituteId], references: [id])
  lesson    Lesson    @relation(fields: [lessonId], references: [id])
  student   Student   @relation(fields: [studentId], references: [id])

  @@unique([instituteId, lessonId, studentId])
  @@map("lesson_attendance")
}

// ---------------------------------------------------------------------------
// Financial (student enrollment contracts — management system only)
// ---------------------------------------------------------------------------

/// Enrollment contract of a student in a section for an academic year.
/// totalAmount = grossAmount - discountAmount.
model StudentSubscription {
  id                   Int                @id @default(autoincrement())
  instituteId          Int                @map("institute_id")
  studentId            Int                @map("student_id")
  sectionId            Int                @map("section_id")
  academicYearId       Int                @map("academic_year_id")
  currency             Currency           @default(SYP)
  exchangeRate         Decimal?           @map("exchange_rate") @db.Decimal(18, 4)
  grossAmount          Decimal            @map("gross_amount") @db.Decimal(18, 2)
  discountAmount       Decimal            @default(0) @map("discount_amount") @db.Decimal(18, 2)
  discountReason       String?            @map("discount_reason")
  totalAmount          Decimal            @map("total_amount") @db.Decimal(18, 2)
  firstPaymentAmount   Decimal?           @map("first_payment_amount") @db.Decimal(18, 2)
  numberOfInstallments Int                @map("number_of_installments")
  startDate            DateTime           @map("start_date") @db.Date
  status               SubscriptionStatus @default(ACTIVE)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  createdById          Int?               @map("created_by_id")
  updatedById          Int?               @map("updated_by_id")

  institute    Institute     @relation(fields: [instituteId], references: [id])
  student      Student       @relation(fields: [studentId], references: [id])
  section      Section       @relation(fields: [sectionId], references: [id])
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  installments Installment[]

  @@unique([instituteId, id])
  @@map("student_subscriptions")
}

model Installment {
  id                Int               @id @default(autoincrement())
  instituteId       Int               @map("institute_id")
  subscriptionId    Int               @map("subscription_id")
  installmentNumber Int               @map("installment_number")
  amount            Decimal           @db.Decimal(18, 2)
  paidAmount        Decimal           @default(0) @map("paid_amount") @db.Decimal(18, 2)
  dueDate           DateTime          @map("due_date") @db.Date
  status            InstallmentStatus @default(PENDING)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  createdById       Int?              @map("created_by_id")
  updatedById       Int?              @map("updated_by_id")

  institute    Institute           @relation(fields: [instituteId], references: [id])
  subscription StudentSubscription @relation(fields: [subscriptionId], references: [id])
  payments     Payment[]

  @@unique([instituteId, id])
  @@unique([instituteId, subscriptionId, installmentNumber])
  @@map("installments")
}

/// Payments are never deleted — they are cancelled (status CANCELLED).
/// receiptNumber is sequential per (institute, branch, academic year).
model Payment {
  id             Int           @id @default(autoincrement())
  instituteId    Int           @map("institute_id")
  branchId       Int           @map("branch_id")
  academicYearId Int           @map("academic_year_id")
  installmentId  Int           @map("installment_id")
  receiptNumber  Int           @map("receipt_number")
  amount         Decimal       @db.Decimal(18, 2)
  currency       Currency      @default(SYP)
  exchangeRate   Decimal?      @map("exchange_rate") @db.Decimal(18, 4)
  paidAt         DateTime      @map("paid_at")
  paymentMethod  PaymentMethod @default(CASH) @map("payment_method")
  status         PaymentStatus @default(ACTIVE)
  cancelReason   String?       @map("cancel_reason")
  note           String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  createdById    Int?          @map("created_by_id")
  updatedById    Int?          @map("updated_by_id")

  institute    Institute    @relation(fields: [instituteId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  installment  Installment  @relation(fields: [installmentId], references: [id])

  @@unique([instituteId, id])
  @@unique([instituteId, branchId, academicYearId, receiptNumber])
  @@map("payments")
}

/// Atomic counter backing Payment.receiptNumber.
model ReceiptSequence {
  id             Int      @id @default(autoincrement())
  instituteId    Int      @map("institute_id")
  branchId       Int      @map("branch_id")
  academicYearId Int      @map("academic_year_id")
  lastNumber     Int      @default(0) @map("last_number")
  updatedAt      DateTime @updatedAt @map("updated_at")

  institute    Institute    @relation(fields: [instituteId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([instituteId, branchId, academicYearId])
  @@map("receipt_sequences")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Change log written automatically by TenantAwareRepository for audited models.
/// userId / entityId are plain columns (no FK) so the log survives any record.
model AuditLog {
  id          Int         @id @default(autoincrement())
  instituteId Int         @map("institute_id")
  userId      Int?        @map("user_id")
  entity      String
  entityId    Int         @map("entity_id")
  action      AuditAction
  before      Json?
  changes     Json?
  createdAt   DateTime    @default(now()) @map("created_at")

  institute Institute @relation(fields: [instituteId], references: [id])

  @@index([instituteId, entity, entityId])
  @@index([instituteId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Feature flags (per institute)
// ---------------------------------------------------------------------------

/// Optional modules an institute can have switched on. No row = disabled.
model InstituteFeature {
  id          Int        @id @default(autoincrement())
  instituteId Int        @map("institute_id")
  key         FeatureKey
  enabled     Boolean    @default(false)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id])

  @@unique([instituteId, id])
  @@unique([instituteId, key])
  @@map("institute_features")
}

