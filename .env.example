# Application
PORT=3000
API_PREFIX=api

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/institutesPlatform

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d


# File storage: local driver directory (relative to the project root)
STORAGE_LOCAL_DIR=uploads

# Redis (cache, rate limiting, locks, queues) — see docker-compose.yml
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=ip:dev

# Rate limiting (requests per window, per IP; login is per IP + phone)
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL_MS=60000
